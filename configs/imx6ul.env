# i.MX6UL 默认板级构建配置。
# 所有路径均由 tools/envsetup.sh 相对工程根目录计算，禁止在此写入主机专用绝对路径。

BOARD_NAME="imx6ull-14x14-ddr256-nand"
ARCH="arm"
CROSS_PREFIX="arm-linux-gnueabihf-"
TOOLCHAIN_REL="tools/toolchain/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabihf"
JOBS_DEFAULT="16"

UBOOT_DEFCONFIG="mytest_defconfig"
UBOOT_IMAGE="u-boot.imx"
# auto：检测到历史构建状态时复用 bootloader/；源码树洁净时使用独立 O= 输出目录。
UBOOT_BUILD_MODE="auto"

# 保持与 kernel/build_all.sh 完全一致的内核基线。
KERNEL_DEFCONFIG="imx_v7_defconfig"
KERNEL_IMAGE_TARGET="zImage"
KERNEL_DTB="imx6ull-14x14-nand-4.3-800x480-c.dtb"

# auto：检测到历史源码树构建状态时使用兼容模式；源码树洁净时使用独立 O= 输出目录。
# out：强制独立输出目录；source：始终复用当前 kernel/ 构建目录。
KERNEL_BUILD_MODE="auto"

BUSYBOX_CONFIG_TARGET="defconfig"
# BusyBox 1.29 的 O= 构建同样要求源码树洁净。
BUSYBOX_BUILD_MODE="auto"

# 外部驱动和 platform 应用的选择列表分别维护在 drivers/build.sh、platform/build.sh，
# 便于在对应目录中集中登记构建规则和发布范围。

RELEASE_VERSION="1.0.0"
ROOTFS_ARCHIVE_NAME="rootfs.tar"
